# PostgreSQL (required for persistence, history, background jobs)
DATABASE_URL=postgresql://packly:packly@localhost:5432/packly

# Capture defaults
CAPTURE_INTERFACE=en0
CAPTURE_FILTER=tcp
CAPTURE_PROMISCUOUS=true
PACKLY_CAPTURE_FALLBACK_TO_MOCK=true

# Auth — when set, required for POST /api/capture/start|stop and history
PACKLY_API_KEY=

# Background jobs
SUMMARY_ROLLUP_INTERVAL_MINUTES=5
PACKET_TTL_DAYS=30
PACKET_TTL_CLEANUP_INTERVAL_HOURS=6

# Socket.IO
SOCKET_IO_PATH=/api/socket
NEXT_PUBLIC_SOCKET_PATH=/api/socket
NEXT_PUBLIC_DEFAULT_INTERFACE=
NEXT_PUBLIC_DEFAULT_FILTER=tcp
